<?xml version="1.0" encoding="utf-8"?>
<robot name="reception" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 1. Include Gazebo plugins -->
  <xacro:include filename="$(find robot_fablab)/urdf/robot_fablab.gazebo"/>

  <!-- ================= BASE FOOTPRINT ================= -->
  <link name="base_footprint">
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= BASE LINK ================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.80547 0.29964 -0.47356" rpy="0 0 0" />
      <mass value="13.533" />
      <inertia ixx="0.22773" ixy="-0.0049825" ixz="5.9491E-05" iyy="0.3509" iyz="5.9312E-05" izz="0.14899" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.74902 0.74902 0.74902 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ================= WHEELS ================= -->
  <link name="Left_wheel">
    <inertial>
      <origin xyz="-0.00025563 0.014871 7.2657E-07" rpy="0 0 0" />
      <mass value="1.0716" />
      <inertia ixx="0.0032564" ixy="1.521E-09" ixz="-6.2778E-09" iyy="0.0062145" iyz="4.2157E-08" izz="0.0032565" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/Left_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0.59608 0.66667 0.68627 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/Left_wheel.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="Left_wheel_joint" type="continuous">
    <origin xyz="0.71544 0.76308 -0.015158" rpy="0 0 -3.1416" />
    <parent link="base_link" />
    <child link="Left_wheel" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <link name="Right_wheel">
    <inertial>
      <origin xyz="-0.00025564 -0.014871 7.261E-07" rpy="0 0 0" />
      <mass value="1.0716" />
      <inertia ixx="0.0032564" ixy="-1.5005E-09" ixz="-6.3105E-09" iyy="0.0062145" iyz="-4.2151E-08" izz="0.0032565" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/Right_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0.59608 0.66667 0.68627 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/Right_wheel.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="Right_wheel_joint" type="continuous">
    <origin xyz="0.71544 0.18036 -0.015158" rpy="0 0 3.1416" />
    <parent link="base_link" />
    <child link="Right_wheel" />
    <axis xyz="0 -1 0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <link name="Caster">
    <inertial>
      <origin xyz="-0.00326890758980913 -0.000105769701198966 -0.0476560909473075" rpy="0 0 0" />
      <mass value="0.378365009719551" />
      <inertia ixx="0.000486902921012301" ixy="4.68634433031941E-08" ixz="-8.39976891943837E-05" iyy="0.000645365810716879" iyz="-4.71799768324587E-07" izz="0.000450276858110533" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/Caster.STL" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/Caster.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="Caster_joint" type="continuous">
    <origin xyz="1.0482 0.47172 -0.0081577" rpy="0 0 -3.1416" />
    <parent link="base_link" />
    <child link="Caster" />
    <axis xyz="0 1 0" />  <!-- fixed axis from 0 0 0 to 0 1 0 -->
    <dynamics damping="0.01" friction="0.01" />
  </joint>

  <!-- ================= SENSORS ================= -->
  <!-- Lidar -->
  <link name="link_lidar">
    <inertial>
      <origin xyz="-0.002487 1.09E-05 -0.024095" rpy="0 0 0" />
      <mass value="0.035081" />
      <inertia ixx="1.9431E-05" ixy="7.3718E-10" ixz="4.0724E-08" iyy="1.932E-05" iyz="-1.091E-09" izz="3.7018E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/link_lidar.STL" />
      </geometry>
      <material name="">
        <color rgba="0 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/link_lidar.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_lidar" type="fixed">
    <origin xyz="0.011534 0.010999 0.55646" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link_lidar" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- Camera -->
  <link name="link_camera">
    <inertial>
      <origin xyz="-0.016107 4.0071E-05 -0.00053431" rpy="0 0 0" />
      <mass value="0.15226" />
      <inertia ixx="0.0003084" ixy="-1.3455E-06" ixz="-4.4401E-08" iyy="2.2766E-05" iyz="9.3764E-09" izz="0.00031076" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/link_camera.STL" />
      </geometry>
      <material name="">
        <color rgba="0.27059 0.27059 0.27059 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes1/link_camera.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_camera" type="fixed">
    <origin xyz="-0.11803 0.012232 1.3955" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link_camera" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- IMU -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>    
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= TRANSMISSION GAZEBO CONTROL ================= -->
  <transmission name="right_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="Right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor_right_wheel">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="Left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor_left_wheel">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  
</robot>
.PHONY : publish_mqtt_node

# fast build rule for target.
publish_mqtt_node/fast:
	$(MAKE) -f publish_mqtt/CMakeFiles/publish_mqtt_node.dir/build.make publish_mqtt/CMakeFiles/publish_mqtt_node.dir/build
.PHONY : publish_mqtt_node/fast

